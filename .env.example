# Copy to .env (git-ignored) and fill in. Variables here override config.yaml.

# --- Provider: anthropic | openai_compat
LLM_PROVIDER=anthropic
# anthropic default: claude-opus-5-5. openai_compat: required, the model id exactly as your
# provider lists it (OpenRouter ids look like "vendor/model").
LLM_MODEL=
# Only for openai_compat (leave empty for api.openai.com):
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# --- Keys: LLM_API_KEY (or its alias ODIN_LLM_API_KEY) wins; otherwise ANTHROPIC_API_KEY /
#     OPENAI_API_KEY by provider. For Gemini / Groq / OpenRouter put that provider's key in LLM_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=

# --- Optional tuning
# LLM_EFFORT=high            # anthropic effort: low|medium|high|xhigh|max, empty to omit
# LLM_FALLBACKS=true         # anthropic server-side refusal fallback
# LLM_JSON_MODE=true         # openai_compat json_object response format
# LLM_MAX_OUTPUT_TOKENS=32000
# ODIN_MAX_LLM_CALLS=60
# ODIN_MAX_TOKENS_BUDGET=1500000
# ODIN_CHUNK_MAX_CHARS=9000  # Thor chunk size; 9000 fits 8k tokens/minute tiers, ~14000 for big providers
# ODIN_BUNDLE_DIR=02_Ragnarok Odin The Contract War Room/Pack/odin_dev_pack/bundle
# ODIN_DB_PATH=state/odin.db
